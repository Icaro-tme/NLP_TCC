# Google Gemini API Configuration
# Obtenha sua chave em: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# LibreTranslate Configuration
# Servidor local (padrão)
LIBRETRANSLATE_URL=http://localhost:5000

# Se usar instância pública (ex: https://libretranslate.com)
# LIBRETRANSLATE_API_KEY=your_libretranslate_api_key_here

# Database Configuration (opcional)
# DATABASE_URL=sqlite:///data/db/tcc.db

# RAG Configuration (opcional)
# RAG_INDEX_PATH=data/rag_index
# RAG_TOP_K=5

# Logging (opcional)
# LOG_LEVEL=INFO
